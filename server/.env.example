# ==========================================
# QUESTBINDER - SERVER ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=3001
HOST=0.0.0.0

# CORS Configuration
CORS_ORIGIN_1=http://localhost:5173
CORS_ORIGIN_2=http://127.0.0.1:5173

# WebSocket Configuration
WS_PING_TIMEOUT=20000
WS_PING_INTERVAL=25000
WS_MAX_HTTP_BUFFER_SIZE=20971520

# Database Configuration
DB_PATH=./data

# Application
NODE_ENV=development
