# ============================================
# QUESTBINDER - Production Environment
# ============================================

# API URL (relative for same-origin requests)
VITE_API_URL=/api

# WebSocket URL (empty = use window.location.origin)
VITE_WS_URL=

# WebSocket reconnection settings
VITE_WS_RECONNECTION_ATTEMPTS=Infinity
VITE_WS_RECONNECTION_DELAY=1000
VITE_WS_RECONNECTION_DELAY_MAX=5000
